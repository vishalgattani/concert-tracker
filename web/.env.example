# Mapbox public token (pk.*) — safe to expose to the browser
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_public_token_here

# Mapbox secret token (sk.*) — server-side only, never sent to client
MAPBOX_SECRET_TOKEN=sk.your_secret_token_here

# EDMTrain API key — server-side only
# Get yours at https://edmtrain.com/dev-api
# Leave unset to use built-in dummy data
EDMTRAIN_API_KEY=
